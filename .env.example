# Application
APP_DOMAIN=localhost:5173
APP_NAME='Progress Report'
APP_SLUG=progress-report
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=file:./data/dev.db

# Session
SESSION_SECRET=change-me-in-production

# Pike13 OAuth (existing)
PIKE13_CLIENT_ID=
PIKE13_CLIENT_SECRET=
PIKE13_CALLBACK_URL=http://localhost:5173/api/auth/pike13/callback
PIKE13_API_BASE=https://jtl.pike13.com/api/v2/desk

# GitHub OAuth (quiz student login)
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Quiz staff role overrides (comma-separated email addresses, optional)
# When set, these emails are granted admin/instructor quiz roles even if not
# found in the admin_settings / instructors tables (useful for local dev).
ADMIN_ALLOWLIST=
INSTRUCTOR_ALLOWLIST=

# CORS (comma-separated allowed origins, leave blank to disable cross-origin)
ALLOWED_ORIGINS=

# Email (SMTP via Amazon SES or equivalent)
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME='App'
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sendgrid (alternative email provider)
SENDGRID_API_KEY=

# Logging
LOG_LEVEL=info
